+++            "T2": tu.tail_T2(x_R, R1t, gamma, W_lm, eps),
+++            "T3": tu.tail_T3(x_R, R1t, gamma, W_lm, eps),
+++            "T4": tu.tail_T4(x_R, gamma, W_lm, eps)}
+++    res = {}
+++    for k, (h, lg) in outs.items():
+++        res[k] = {**logit_metrics(lg, lg0), **hidden_metrics(h, h0)}
+++    return res
