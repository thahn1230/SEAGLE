+++        qf = F.log_softmax(q_fp[pi], -1)              # [T-1, V] (pos 1..T-1)
+++        qq = F.log_softmax(q_q[pi], -1)
+++        # generated region only: predicting tokens L0..T-1 -> target rows L0-1..,
