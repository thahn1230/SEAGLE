+++            g("T2:naive") > 0.9 * g("T1:A") and g("T3:naive") > 0.9 * g("T1:A")
+++            and g("T1:naive") < 0.5 * g("T1:A")),
+++        "H5_overhead_small_frac": best_overhead,
+++        "H5_overhead_under_3pct": bool(best_overhead < 0.03),
