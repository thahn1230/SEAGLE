+++flowchart LR
+++    T[h_hat] --> C["FOLDED fc h-block<br/>W_h' = W_h diag(gamma_f) R1"]
+++    E[e] --> C
+++    C --> F[f original basis]
+++    F -->|"recycle f: WRONG, folded fc<br/>expects S-basis input"| C
+++    F --> H[original lm_head]
+++    style F fill:#fdd
