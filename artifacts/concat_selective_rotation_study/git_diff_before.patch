+++def _fig_overhead(rd, e2e):
+++    fig, ax = plt.subplots(figsize=(7, 4))
+++    conds = [c for c in ["T1:A", "T1:B2", "T2:naive", "T3:naive"]
+++             if c in set(e2e["condition"])]
+++    sub = e2e.set_index("condition")
+++    labels, tgt, drf, ver, tail = [], [], [], [], []
